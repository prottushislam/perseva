{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perseva",
  "main": "./build/cloudflare-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perseva-db",
